#
# pre-commit -- every commit moves the version on, and its JS is
# formatted by prettier.
#
# A patch bump is the default because it is the safe answer when nobody
# has said otherwise. A commit that adds a feature or breaks something
# says so first:
#
#     node tools/version.mjs bump minor
#
# and this hook then leaves the version alone, because it is already
# ahead of the committed one.
#
# Installed by `npm install` (package.json's "prepare" script), or by
# hand with:  git config core.hooksPath tools/githooks
#

set -euo pipefail

# Nothing to move on from in the very first commit, and nothing sensible
# to do in the middle of a merge or a rebase either.
git rev-parse -q --verify HEAD >/dev/null 2>&1 || exit 0
git_dir=$(git rev-parse --git-dir)
if [ -e "$git_dir/MERGE_HEAD" ] \
  || [ -d "$git_dir/rebase-merge" ] \
  || [ -d "$git_dir/rebase-apply" ]; then
  exit 0
fi

# All JS is laid out by prettier (see .prettierrc.json). Check what is
# actually staged, not the working tree, so a half-staged file is judged
# on the half that is going in.
if [ -x node_modules/.bin/prettier ]; then
  unformatted=()
  while IFS= read -r -d '' file; do
    if ! git show ":$file" \
        | node_modules/.bin/prettier --stdin-filepath "$file" --check >/dev/null 2>&1; then
      unformatted+=("$file")
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.js' '*.mjs')
  if [ ${#unformatted[@]} -gt 0 ]; then
    echo "pre-commit: not formatted by prettier:" >&2
    printf '  %s\n' "${unformatted[@]}" >&2
    echo "run: npm run format   (then git add them again)" >&2
    exit 1
  fi
else
  echo "pre-commit: prettier not installed (npm install); skipping format check" >&2
fi

version_in() {
  git show "$1:package.json" 2>/dev/null \
    | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    | head -1
}

staged=$(git show :package.json 2>/dev/null \
  | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
committed=$(version_in HEAD)

if [ -z "$staged" ] || [ -z "$committed" ]; then
  echo "pre-commit: no version field found; leaving it alone" >&2
  exit 0
fi

if [ "$staged" != "$committed" ]; then
  echo "pre-commit: version already set to $staged"
  exit 0
fi

next=$(node tools/version.mjs bump patch)
git add package.json
echo "pre-commit: version $committed -> $next"
