# systemd unit for the telemetry server: /etc/systemd/system/mu-telemetry.service
# It listens on 127.0.0.1 only; nginx is what the internet reaches.

[Unit]
Description=Monochrome Unicorn deploy telemetry
After=network.target

[Service]
User=mu-telemetry
Group=mu-telemetry
WorkingDirectory=/opt/mu-telemetry
# The log's directory, /var/lib/mu-telemetry, is made by hand (see
# README.md): StateDirectory= would do it, but not on systemd before 235,
# such as Amazon Linux 2's 219.
Environment=TELEMETRY_LOG=/var/lib/mu-telemetry/telemetry.jsonl
# TELEMETRY_PASSWORD (and TELEMETRY_USER, if not admin) for the summary
# page, in a file only root reads; without one there is no summary page.
EnvironmentFile=-/etc/mu-telemetry.env
ExecStart=/opt/mu-telemetry/venv/bin/uvicorn server:app \
    --host 127.0.0.1 --port 8701 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1 \
    --no-server-header
Restart=on-failure
NoNewPrivileges=yes
# full rather than strict, which needs systemd 232; /var stays writable.
ProtectSystem=full
# read-only, not yes: a Python installed by uv lives in the user's home,
# and the venv's interpreter is a link to it.
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
