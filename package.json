{
  "name": "zebra-printer-web-app",
  "version": "0.18.2",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Tyler Whittaker",
  "type": "module",
  "description": "Single-page app served from a Zebra printer's onboard web server (E:INDEX.SHTML)",
  "scripts": {
    "css": "tailwindcss -i src/css/app.css -o dist/app.css --minify",
    "build": "node tools/build.mjs",
    "deploy": "./deploy.sh",
    "version:show": "node tools/version.mjs",
    "prepare": "git config core.hooksPath tools/githooks",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\""
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17"
  }
}
