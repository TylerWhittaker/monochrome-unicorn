  "author": "Tyler Whittaker",
  "type": "module",
  "description": "Single-page app served from a Zebra printer's onboard web server (E:INDEX.SHTML)",
  "scripts": {
    "css": "tailwindcss -i src/css/app.css -o dist/app.css --minify",
